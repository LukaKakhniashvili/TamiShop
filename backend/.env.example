# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_mvp

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google OAuth (Google Identity Services / One Tap)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMTP Email Configuration (Nodemailer)
# To send actual emails, fill these out with your SMTP provider credentials (e.g. Gmail App Password, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_or_smtp_password
# All emails are sent as "Tam`i Shop" <SMTP_USER>. With Gmail SMTP the From address must be the same account.
# EMAIL_REPLY_TO=support@your-domain.ge   # optional — where customer replies go
# EMAIL_DELIVERY=log   # don't send — print emails to the server console (local development / tests)

# Test-environment gate: visitors must enter this code to open the site
DEV_ACCESS_CODE=your_access_code

# Card payments are temporarily disabled; set to true once a bank integration is live
CARD_PAYMENTS_ENABLED=false

# Card payments (bank hosted payment page, opened in the checkout modal)
# Without a bank's credentials, that bank uses the built-in sandbox page in development
# (disabled when NODE_ENV=production unless ALLOW_SANDBOX_PAYMENTS=true).
# Public URL of this API — banks send payment callbacks here (must be reachable from the internet)
PUBLIC_API_URL=
# Bank of Georgia (Payments API)
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
# BOG_AUTH_URL=https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token
# BOG_API_URL=https://api.bog.ge/payments/v1
# TBC Bank (tpay)
TBC_API_KEY=
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
# TBC_API_URL=https://api.tbcbank.ge/v1/tpay
